-- Загрузка списка построек из GitHub (папка /main/build/)
-- Так как GitHub API сложен, мы предполагаем, что у тебя есть файл list.json со списком имен файлов в этой папке
local function loadBuilds()
    local listUrl = GitHubBaseUrl .. "/build/list.json" 
    local success, response = pcall(function() return game:HttpGet(listUrl) end)
    
    if success then
        local builds = HttpService:JSONDecode(response) -- Ожидается формат {"Mini-Titan": "Описание...", "Ship": "..."}
        for name, desc in pairs(builds) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 40)
            btn.Text = name .. " - " .. desc
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Parent = BuildList
            btn.MouseButton1Click:Connect(function()
                executeBuild(GitHubBaseUrl .. "/build/" .. name .. ".json")
            end)
        end
    end
end

if IsVerified then loadBuilds() end -- Если зашел сразу (в будущем)
VerifyBtn.MouseButton1Click:Connect(function() 
