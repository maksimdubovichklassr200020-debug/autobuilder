-- Функция строительства (из предыдущего ответа)
local function executeBuild(jsonUrl)
    local success, response = pcall(function() return game:HttpGet(jsonUrl) end)
    if not success then return end
    
    local lines = response:split("\n")
    for _, line in pairs(lines) do
        if line ~= "" then
            local cleanLine = line:gsub("=end", "")
            local parts = cleanLine:split("-")
            if #parts == 3 then
                local name, pos, size = parts[1], parts[2], parts[3]
                local pCoords = pos:split(" ")
                local sCoords = size:split(" ")
                
                local block = Instance.new("Part")
                block.Name = name
                block.Position = Vector3.new(tonumber(pCoords[1]), tonumber(pCoords[2]), tonumber(pCoords[3]))
                block.Size = Vector3.new(tonumber(sCoords[1]), tonumber(sCoords[2]), tonumber(sCoords[3]))
                block.Anchored = true
                block.Parent = Workspace
                task.wait(0.01)
            end
        end
    end
end

